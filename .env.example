# ============================================
# 一日三餐 RAG 系统环境变量配置模板
# 复制此文件为 .env 并填入实际值:  cp .env.example .env
# ============================================

# --- 必填 ---

# Moonshot (Kimi) API Key
# 获取地址: https://platform.moonshot.cn/console/api-keys
MOONSHOT_API_KEY=your_moonshot_api_key_here

# --- 可选（以下有默认值，不填则使用 config.py 中的默认配置）---

# [路径] 食谱数据目录路径

DATA_PATH=./dishes

# [路径] 向量索引保存目录
# 默认: ./vector_index
INDEX_SAVE_PATH=./vector_index

# [模型] Embedding 模型名称（用于文本向量化）
# 默认: BAAI/bge-small-zh-v1.5
# 其他可选: BAAI/bge-base-zh-v1.5, BAAI/bge-large-zh-v1.5
# 注意: 更换模型需确保本地/镜像可下载
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# [模型] 大语言模型名称（用于生成回答）
# 其他可选: moonshot-v1-8k, moonshot-v1-32k, moonshot-v1-128k
LLM_MODEL=kimi-k2.6


# [检索] 返回最相关的文档块数量
# 默认: 3
TOP_K=3

# [生成] LLM 生成温度（0.0~2.0，越低越确定/保守）
# 默认: 0.1
TEMPERATURE=1

# [生成] LLM 最大生成 token 数
# 默认: 2048
MAX_TOKENS=2048
